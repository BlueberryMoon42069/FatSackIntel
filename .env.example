# Required
DATABASE_URL=postgresql://user:password@localhost:5432/sackfinder

# Optional - Social media scraping
TWITTER_BEARER_TOKEN=           # Twitter API v2 Bearer Token for social signal scraping

# Optional - Solar potential
NREL_API_KEY=                   # NREL PVWatts API key (falls back to DEMO_KEY with rate limits)

# Server
PORT=5000
NODE_ENV=development
